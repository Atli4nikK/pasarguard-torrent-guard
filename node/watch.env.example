# Настройки агента torrent-watch (/etc/torrent-guard/watch.env, права 0600 — здесь токен бота).
# После правки: systemctl restart torrent-guard-watch

# Имя ноды в алертах и метриках (install подставляет hostname)
TORRENT_WATCH_NODE=

# Алерты в Telegram прямо с ноды. Пусто — выключено, остаются только метрики Prometheus.
# Токен — у @BotFather, chat id — ваш личный id или id группы (бот должен быть в группе).
TORRENT_WATCH_TG_TOKEN=
TORRENT_WATCH_TG_CHAT=
# Если Telegram API с ноды недоступен (например, нода в РФ) — адрес своего прокси-зеркала API
TORRENT_WATCH_TG_API=https://api.telegram.org
# Не чаще одного алерта о пользователе за столько секунд
TORRENT_WATCH_TG_COOLDOWN=3600

# Где искать access-лог Xray (каталог данных pg-node смонтирован в контейнер под тем же путём)
TORRENT_WATCH_GLOB=/var/lib/*/xray-access.log
# Файл метрик для textfile collector node exporter
TORRENT_WATCH_OUT=/var/lib/prometheus/node-exporter/spaceguard_torrent.prom
# Обнулять access-лог, когда он больше стольких байт
TORRENT_WATCH_MAX_BYTES=33554432
